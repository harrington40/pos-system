{
  "name": "momo-transfer-backend",
  "version": "1.0.0",
  "description": "Backend service for MoMo Transfer app using MQTT, RethinkDB, and gRPC",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:watch": "nodemon --exec ts-node src/index.ts",
    "proto:generate": "protoc --plugin=protoc-gen-ts=./node_modules/.bin/protoc-gen-ts --ts_out=grpc_js:src/grpc/generated --proto_path=src/grpc/proto src/grpc/proto/*.proto",
    "db:migrate": "ts-node src/database/migrations/index.ts",
    "db:seed": "ts-node src/database/seeds/index.ts",
    "mqtt:test": "ts-node src/mqtt/test-client.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.9.14",
    "@grpc/proto-loader": "^0.7.10",
    "@types/mqtt": "^2.5.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.12.23",
    "mqtt": "^5.3.0",
    "nanoid": "^3.3.11",
    "rethinkdb": "^2.4.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.9.0",
    "@types/rethinkdb": "^2.3.21",
    "@types/uuid": "^9.0.7",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.4.0",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "momo",
    "mobile-money",
    "mqtt",
    "rethinkdb",
    "grpc",
    "fintech",
    "payments"
  ],
  "author": "MoMo Transfer Team",
  "license": "MIT"
}
