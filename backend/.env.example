# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/pos-menu

# Server Configuration
PORT=5000

# AI Integration (Development Only)
# Get your API keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Choose which AI provider to use (openai or deepseek)
# Default: openai
AI_PROVIDER=openai

# Environment for controlling feature flags
# Development mode enables AI debug endpoints at /api/ai
NODE_ENV=development

# Mobile Money Configuration
# Set to 'simulation' for development (auto-confirms after 15s)
# Set to 'production' for real API calls
MOBILE_MONEY_MODE=simulation

# Orange Money API (production)
ORANGE_MONEY_API_URL=https://api.orange.com/money/v1
ORANGE_MONEY_CLIENT_ID=your_client_id
ORANGE_MONEY_CLIENT_SECRET=your_client_secret

# MTN Mobile Money API (production)
# Base URL: Use sandbox for testing, production for live
# Sandbox: https://sandbox.momodeveloper.mtn.com
# Production: https://proxy.momoapi.mtn.com
MTN_MOMO_API_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=your_subscription_key
MTN_MOMO_API_USER=your_api_user
MTN_MOMO_API_KEY=your_api_key

# MTN MoMo Callback URL (publicly accessible URL for MTN to send webhooks)
# In production, this must be a publicly accessible HTTPS URL
MTN_MOMO_CALLBACK_URL=http://localhost:5000/api/mobile-payments/webhook/mtn

# MTN MoMo Currency (EUR for sandbox, XAF for production in Cameroon)
MTN_MOMO_CURRENCY=EUR

# Backblaze B2 Configuration (for menu image & document storage)
# Get your credentials from: https://secure.backblaze.com/app_keys.htm
# Create a public bucket in the B2 console
# File structure inside bucket:
#   menu/{itemId}_{timestamp}.{ext}     — Menu item images
#   avatars/{itemId}_{timestamp}.{ext}  — Menu item avatars/thumbnails
#   documents/{type}_{timestamp}.{ext}  — General documents
B2_APPLICATION_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=restaurant-pos-assets
# S3-compatible endpoint for your B2 region
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# Optional: Custom CDN domain (e.g., Cloudflare) for faster image delivery
# B2_CDN_URL=https://cdn.example.com
