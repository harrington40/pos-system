# Server Configuration
PORT=3000
NODE_ENV=development

# OrientDB Configuration
ORIENTDB_HOST=localhost
ORIENTDB_PORT=2424
ORIENTDB_USERNAME=admin
ORIENTDB_PASSWORD=admin
ORIENTDB_DATABASE=smart_sip

# KeyDB Configuration (High-performance Redis fork)
KEYDB_HOST=localhost
KEYDB_PORT=6379
KEYDB_PASSWORD=

# Asterisk Configuration
ASTERISK_HOST=localhost
ASTERISK_PATH=/usr/src/asterisk-21
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=admin
ASTERISK_AMI_SECRET=secret

# SIP Configuration
SIP_WSS_SERVER=wss://localhost:8089/ws
SIP_DOMAIN=localhost

# JWT Configuration (if needed for auth)
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRES_IN=1d

# AI Integration (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Logging
LOG_LEVEL=debug
