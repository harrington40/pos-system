{
  "extends": "./tsconfig.json",
  // `scripts/` holds the offline licence-key CLI, which runs through ts-node and
  // does not belong in the shipped build. It must stay excluded: compiling a file
  // outside src/ moves TypeScript's inferred root up a level, so the build emits
  // dist/src/main.js instead of dist/main.js and the deploy refuses the tarball.
  "exclude": ["node_modules", "test", "dist", "scripts", "**/*spec.ts"],
  "compilerOptions": {
    // Source maps must not ship to production: they map the compiled output
    // straight back to the TypeScript sources, exposing the whole backend to
    // anyone who fetches them. The deploy uploads dist/ as-is, so this is the
    // last place to stop it. For a debugging build, override locally with
    // `npx nest build --sourceMap` or add the flag back temporarily.
    "sourceMap": false,
    // .d.ts files are only useful to consumers of a library; nothing here reads
    // them at runtime, and they reveal the internal shape of every module.
    "declaration": false
  }
}
