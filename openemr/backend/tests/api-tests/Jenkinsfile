// OpenRx CI pipeline — production read-only API verification (+ optional UI sweep).
//
//   production API ──authenticated GET──▶ discovery ──sanitized fixtures──▶ tests
//                                        (read-only; nothing is ever written)
//
// Stages:
//   1. Production discovery + baseline   (ci/run-production-baseline.sh)
//   2. Full API sweep (e2e)              (backend/tests/api-tests/e2e/)
//   3. UI sweep (Playwright)             (tests/ui-tests/) — opt-in via RUN_UI_TESTS
//   4. JS unit tests (Jest + Vitest)     (backend/src, interface/new) — RUN_JS_TESTS
//   5. Test reliability report           (tests/build_reliability_report.py)
//
// Published HTML (HTML Publisher plugin, both self-contained):
//   * "API Test Report"          — backend/tests/api-tests/html-report/pytest-report.html
//   * "Test Reliability Report"  — tests/reliability-report.html
// Machine-readable metrics: tests/reliability-report.json (archived for trends).
//
// Point a Jenkins job at this file ("Pipeline script from SCM", script path
// backend/tests/api-tests/Jenkinsfile).
//
// Job configuration:
//   * environment variable OPENRX_BASELINE_API_URL — the API to verify, e.g.
//     https://openrx.transtechologies.com/api
//   * a Secret text credential whose id is `openrx-baseline-token` — a service
//     token with read access. Without it the authenticated tests skip and the
//     job would look green while testing nothing, so the baseline script fails.
//   * UI sweep: tick RUN_UI_TESTS and set UI_BASE_URL (a browser-capable agent is
//     required; the stage installs Chromium via Playwright on the fly).
//
// Retention: build ARTIFACTS ARE DELETED AFTER ONE DAY (artifactDaysToKeepStr);
// build records are kept 30 days / 50 builds. See options.buildDiscarder below.
//
// Nothing here writes to the API: conftest.py skips `production_write` and
// `destructive` tests unless OPENRX_RUN_WRITES=true, which this pipeline never sets.
pipeline {
    agent any

    /*
     * Run automatically, approximately once an hour.
     *
     * `H` asks Jenkins to hash the minute, so builds are spread across the hour
     * (and across agents) instead of every job firing at :00. Use `H * * * *`
     * (this job) or a specific offset such as `H/15 * * * *` for a denser
     * schedule. The production API is only ever read, so an hourly run is safe;
     * see the notes in README.md about the number of requests it makes.
     */
    options {
        // Keep a bounded build history, but DELETE THE BUILD ARTIFACTS AFTER ONE
        // DAY — they are throwaway XML/HTML test reports and pile up fast at an
        // hourly cadence. Raise artifactDaysToKeepStr for a longer window.
        buildDiscarder(logRotator(
            numToKeepStr: '50',
            daysToKeepStr: '30',
            artifactDaysToKeepStr: '1',
            artifactNumToKeepStr: '5',
        ))
        // Never let one slow discovery run overlap the next hourly build.
        disableConcurrentBuilds()
        // Fail fast rather than hang if the API is unreachable.
        timeout(time: 45, unit: 'MINUTES')
    }

    parameters {
        booleanParam(name: 'RUN_UI_TESTS', defaultValue: false,
            description: 'Run the Playwright UI sweep (needs UI_BASE_URL and a browser-capable agent).')
        string(name: 'UI_BASE_URL', defaultValue: '',
            description: 'SPA origin for UI tests, e.g. https://openrx.transtechologies.com')
        booleanParam(name: 'RUN_JS_TESTS', defaultValue: true,
            description: 'Run the Jest/Vitest unit suites so the reliability report uses fresh JS numbers (needs node/npm; skipped automatically if absent).')
    }

    environment {
        OPENRX_BASELINE_API_URL = "${env.OPENRX_BASELINE_API_URL ?: 'https://openrx.transtechologies.com/api'}"
        OPENRX_API_URL = "${env.OPENRX_BASELINE_API_URL ?: 'https://openrx.transtechologies.com/api'}"
        // This pipeline is the *sanctioned* read-only production baseline: it
        // deliberately reads the live API. The suites now refuse to touch the
        // main server unless this is set, so an ad-hoc/local run (or a stray
        // OPENRX_API_URL) fails closed instead of quietly reading real data.
        OPENRX_ALLOW_PRODUCTION = 'true'
        OPENRX_VENV = "${env.OPENRX_VENV ?: (env.WORKSPACE + '/.api-tests-venv')}"
        OPENRX_JUNIT_XML = "${env.WORKSPACE}/backend/tests/api-tests/pytest-results.xml"
        OPENRX_HTML_REPORT = "${env.WORKSPACE}/backend/tests/api-tests/html-report/pytest-report.html"
        OPENRX_RELIABILITY_REPORT = "${env.WORKSPACE}/tests/reliability-report.html"
    }

    triggers {
        cron('H * * * *')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Production discovery + baseline') {
            steps {
                withCredentials([string(credentialsId: 'openrx-baseline-token', variable: 'OPENRX_API_TOKEN')]) {
                    sh '''
                        set -e
                        command -v python3 >/dev/null 2>&1 || { echo "python3 is required"; exit 1; }
                        cd backend/tests/api-tests
                        chmod +x ci/run-production-baseline.sh
                        ./ci/run-production-baseline.sh
                    '''
                }
            }
        }

        // Broad, read-only sweep of the whole API (backend/tests/api-tests/e2e/).
        // Only GETs and anonymous probes; write routes are never called here.
        stage('Full API sweep (e2e)') {
            steps {
                withCredentials([string(credentialsId: 'openrx-baseline-token', variable: 'OPENRX_API_TOKEN')]) {
                    sh '''
                        set -e
                        cd backend/tests/api-tests
                        if [ ! -x "$OPENRX_VENV/bin/python" ]; then
                            python3 -m venv "$OPENRX_VENV"
                            "$OPENRX_VENV/bin/python" -m pip install --quiet --upgrade pip
                            "$OPENRX_VENV/bin/python" -m pip install --quiet -r requirements.txt
                        fi
                        "$OPENRX_VENV/bin/python" -m pytest e2e/ -q \
                            --junitxml=e2e/pytest-results.xml
                    '''
                }
            }
        }

        // Optional browser sweep (tests/ui-tests/, Playwright). Off by default:
        // enable with the RUN_UI_TESTS parameter and set UI_BASE_URL.
        stage('UI sweep (Playwright)') {
            when { expression { return params.RUN_UI_TESTS && (params.UI_BASE_URL?.trim() ?: false) } }
            steps {
                withCredentials([string(credentialsId: 'openrx-baseline-token', variable: 'OPENRX_API_TOKEN')]) {
                    sh '''
                        set -e
                        cd tests/ui-tests
                        python3 -m venv .venv
                        .venv/bin/python -m pip install --quiet --upgrade pip
                        .venv/bin/python -m pip install --quiet -r requirements.txt
                        .venv/bin/python -m playwright install chromium
                        UI_BASE_URL="$UI_BASE_URL" UI_API_URL="$OPENRX_API_URL" UI_TOKEN="$OPENRX_API_TOKEN" \
                            .venv/bin/python -m pytest -q --junitxml=pytest-results.xml
                    '''
                }
            }
        }

        // Unit suites (Jest backend, Vitest frontend). Feeds the reliability
        // report fresh numbers. Best-effort: if node/npm are unavailable the
        // stage clears any committed snapshot so the report shows "not run"
        // rather than stale data. Gated by RUN_JS_TESTS (default on).
        stage('JS unit tests (Jest + Vitest)') {
            when { expression { return params.RUN_JS_TESTS } }
            steps {
                sh '''
                    set -e
                    mkdir -p tests/reliability-artifacts
                    rm -f tests/reliability-artifacts/jest-results.json \
                          tests/reliability-artifacts/jest-coverage-summary.json \
                          tests/reliability-artifacts/vitest-results.json
                    if ! command -v npm >/dev/null 2>&1 || ! command -v node >/dev/null 2>&1; then
                        echo "[js] node/npm not available; JS suites will show as 'not run'"
                        exit 0
                    fi
                    echo "[js] backend Jest (+ coverage)"
                    ( cd backend && npm ci --no-audit --no-fund >/dev/null 2>&1 || true
                      npx jest --ci --coverage --coverageReporters=json-summary \
                        --json --outputFile=../tests/reliability-artifacts/jest-results.json || true )
                    cp -f backend/coverage/coverage-summary.json \
                          tests/reliability-artifacts/jest-coverage-summary.json 2>/dev/null || true
                    echo "[js] frontend Vitest"
                    ( cd interface/new && npm ci --no-audit --no-fund >/dev/null 2>&1 || true
                      npx vitest run --reporter=json \
                        --outputFile=../../tests/reliability-artifacts/vitest-results.json || true )
                    echo "[js] done"
                '''
            }
        }

        // Aggregate every suite (backend unit, frontend unit, API contract,
        // API e2e, UI) into one self-contained reliability page: kind, results,
        // per-suite confidence and coverage. Best-effort — it reads the JUnit
        // XMLs the stages above produced and degrades gracefully when a result
        // file is missing. Pure standard-library Python, so no venv is needed.
        stage('Test reliability report') {
            steps {
                sh '''
                    set -e
                    OUT="${OPENRX_RELIABILITY_REPORT:-$WORKSPACE/tests/reliability-report.html}"
                    python3 tests/build_reliability_report.py --collect \
                        --out "$OUT" --json "${OUT%.html}.json"
                    echo "[reliability] wrote $OUT and ${OUT%.html}.json"
                '''
            }
        }
    }

    post {
        always {
            // JUnit powers the "Test Result" summary and trend in Jenkins across
            // all three suites (baseline, full API sweep, UI sweep).
            junit allowEmptyResults: true, testResults: '**/pytest-results*.xml'

            // Publish both self-contained HTML pages via the HTML Publisher
            // plugin: the pytest baseline report and the aggregated reliability
            // report. Each call is wrapped because the plugin may not be
            // installed; both pages are archived as artifacts either way.
            script {
                try {
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'backend/tests/api-tests/html-report',
                        reportFiles: 'pytest-report.html',
                        reportName: 'API Test Report',
                        reportTitles: 'OpenRx API baseline',
                    ])
                } catch (err) {
                    echo "HTML Publisher unavailable (install the 'HTML Publisher' plugin): ${err}"
                }
                try {
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'tests',
                        reportFiles: 'reliability-report.html',
                        reportName: 'Test Reliability Report',
                        reportTitles: 'OpenRx test reliability',
                    ])
                } catch (err) {
                    echo "HTML Publisher unavailable (install the 'HTML Publisher' plugin): ${err}"
                }
            }

            archiveArtifacts(
                artifacts: 'backend/tests/api-tests/fixtures/production_discovery.json,backend/tests/api-tests/pytest-results.xml,backend/tests/api-tests/e2e/pytest-results.xml,tests/ui-tests/pytest-results.xml,backend/tests/api-tests/html-report/pytest-report.html,tests/reliability-report.html,tests/reliability-report.json',
                allowEmptyArchive: true
            )
        }
    }
}
