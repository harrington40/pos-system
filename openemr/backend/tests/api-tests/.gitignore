# pytest's report. The pattern is relative to THIS directory, so it must not be
# prefixed with tests/api-tests/ — that never matched anything, which is how a
# stale report ended up committed and archived on every build.
pytest-results.xml

# Generated HTML test report (Jenkins publishes it; never committed).
html-report/
pytest-report.html

# pytest / Python bytecode artifacts
.pytest_cache/
__pycache__/
*.pyc

# Local virtualenv (NOTE: a venv is currently committed under this path; see
# the repository README. This rule stops new files being added to it.)
.venv/
.coverage

